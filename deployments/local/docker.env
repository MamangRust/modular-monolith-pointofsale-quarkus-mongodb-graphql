APP_ENV=docker

# Satu database = satu bounded context: lima instance MongoDB terpisah
# (identity/merchant/catalog/sales/email), lihat docker-compose.yml. HOST
# menunjuk ke service MongoDB compose, PORT selalu 27017 di dalam network.
MONGO_IDENTITY_HOST=mongo_identity
MONGO_IDENTITY_PORT=27017
MONGO_IDENTITY_DB=pos_identity

MONGO_MERCHANT_HOST=mongo_merchant
MONGO_MERCHANT_PORT=27017
MONGO_MERCHANT_DB=pos_merchant

MONGO_CATALOG_HOST=mongo_catalog
MONGO_CATALOG_PORT=27017
MONGO_CATALOG_DB=pos_catalog

MONGO_SALES_HOST=mongo_sales
MONGO_SALES_PORT=27017
MONGO_SALES_DB=pos_sales

MONGO_EMAIL_HOST=mongo_email
MONGO_EMAIL_PORT=27017
MONGO_EMAIL_DB=pos_email


SECRET_KEY=yantopedia

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight

KAFKA_BROKERS=localhost:9092

# ClickHouse (stats pipeline F3)
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=pos
CLICKHOUSE_USERNAME=dragon
CLICKHOUSE_PASSWORD=dragon_knight

# stats_reader listens on this bind address; apigateway dials GRPC_STATS_READER_ADDR
STATS_READER_LISTEN_ADDR=:50070
GRPC_STATS_READER_ADDR=stats_reader:50070
GRPC_STATS_READER_PORT=50070

GRPC_AUTH_ADDR=auth:50051
GRPC_ROLE_ADDR=role:50052
GRPC_USER_ADDR=user:50053
GRPC_CATEGORY_ADDR=category:50054
GRPC_CASHIER_ADDR=cashier:50055
GRPC_MERCHANT_ADDR=merchant:50056
GRPC_ORDERITEM_ADDR=orderitem:50057
GRPC_ORDER_ADDR=order:50058
GRPC_PRODUCT_ADDR=product:50059
GRPC_TRANSACTION_ADDR=transaction:50060

GRPC_AUTH_PORT=50051
GRPC_ROLE_PORT=50052
GRPC_USER_PORT=50053
GRPC_CATEGORY_PORT=50054
GRPC_CASHIER_PORT=50055
GRPC_MERCHANT_PORT=50056
GRPC_ORDERITEM_PORT=50057
GRPC_ORDER_PORT=50058
GRPC_PRODUCT_PORT=50059
GRPC_TRANSACTION_PORT=50060

REDIS_DB_AUTH=0
REDIS_DB_ROLE=1
REDIS_DB_USER=2
REDIS_DB_CATEGORY=3
REDIS_DB_CASHIER=4
REDIS_DB_MERCHANT=5
REDIS_DB_ORDERITEM=6
REDIS_DB_ORDER=7
REDIS_DB_PRODUCT=8
REDIS_DB_TRANSACTION=9
REDIS_DB_APIGATEWAY=10

METRIC_AUTH_ADDR=8081
METRIC_ROLE_ADDR=8082
METRIC_USER_ADDR=8083
METRIC_CATEGORY_ADDR=8084
METRIC_CASHIER_ADDR=8085
METRIC_MERCHANT_ADDR=8086
METRIC_ORDERITEM_ADDR=8087
METRIC_ORDER_ADDR=8088
METRIC_PRODUCT_ADDR=8089
