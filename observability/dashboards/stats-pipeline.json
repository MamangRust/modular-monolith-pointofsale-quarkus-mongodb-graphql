{
  "dashboard": null,
  "panels": [
    {
      "title": "Outbox Pending Rows",
      "type": "stat",
      "targets": [{"expr": "outbox_pending_total", "legendFormat": "Pending"}],
      "fieldConfig": {
        "thresholds": {
          "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 1000},
            {"color": "red", "value": 5000}
          ]
        }
      }
    },
    {
      "title": "Outbox Published Rate",
      "type": "timeseries",
      "targets": [{"expr": "rate(outbox_published_total[5m])", "legendFormat": "Published/s"}]
    },
    {
      "title": "Outbox Failed Rate",
      "type": "timeseries",
      "targets": [{"expr": "rate(outbox_failed_total[5m])", "legendFormat": "Failed/s"}]
    },
    {
      "title": "Stats Writer Events Consumed",
      "type": "timeseries",
      "targets": [{"expr": "rate(stats_writer_events_consumed_total[5m])", "legendFormat": "Events/s"}]
    },
    {
      "title": "Stats Writer Kafka Lag",
      "type": "stat",
      "targets": [{"expr": "stats_writer_kafka_lag", "legendFormat": "Lag"}],
      "fieldConfig": {
        "thresholds": {
          "steps": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 1000},
            {"color": "red", "value": 10000}
          ]
        }
      }
    },
    {
      "title": "Stats Writer Batch Pending",
      "type": "stat",
      "targets": [{"expr": "stats_writer_batch_pending", "legendFormat": "Pending"}]
    },
    {
      "title": "Stats Writer Flush Errors",
      "type": "timeseries",
      "targets": [{"expr": "rate(stats_writer_flush_errors_total[5m])", "legendFormat": "Errors/s"}]
    },
    {
      "title": "Stats Reader Query Duration P95",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, rate(stats_reader_query_duration_seconds_bucket[5m]))", "legendFormat": "P95"}]
    },
    {
      "title": "Stats Reader Cache Hit Rate",
      "type": "gauge",
      "targets": [{"expr": "stats_reader_cache_hit_rate", "legendFormat": "Hit Rate"}],
      "fieldConfig": {
        "unit": "percentunit",
        "thresholds": {
          "steps": [
            {"color": "red", "value": 0},
            {"color": "yellow", "value": 0.5},
            {"color": "green", "value": 0.8}
          ]
        }
      }
    },
    {
      "title": "Stats Reader Errors",
      "type": "timeseries",
      "targets": [{"expr": "rate(stats_reader_errors_total[5m])", "legendFormat": "Errors/s"}]
    }
  ],
  "title": "Stats Pipeline Dashboard",
  "uid": "stats-pipeline",
  "tags": ["stats", "clickhouse", "kafka"]
}
